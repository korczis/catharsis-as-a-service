{
  "name": "catharsis-as-a-service",
  "version": "0.0.0",
  "private": true,
  "description": "Catharsis as a Service™ — emotional state transition endpoint. A Sig Nihl / Prismatic digital artifact.",
  "license": "UNLICENSED",
  "homepage": "https://korczis.github.io/catharsis-as-a-service/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/korczis/catharsis-as-a-service.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "vendor": "node scripts/vendor.mjs",
    "css": "tailwindcss --input styles/app.css --output static/css/app.css --minify",
    "assets": "npm run --silent vendor && npm run --silent css",
    "studies": "python3 scripts/generate-study-pages.py",
    "terms": "python3 scripts/generate-term-pages.py",
    "build": "npm run --silent assets && npm run --silent studies && npm run --silent terms && zola build && python3 scripts/export-api.py --out public",
    "dev": "scripts/dev.sh",
    "preview": "scripts/preview.sh",
    "validate": "scripts/validate.sh",
    "test": "playwright test",
    "test:python": ".venv/bin/python -m pytest tests/python",
    "test:production": "BASE_URL=${BASE_URL:-https://korczis.github.io/catharsis-as-a-service/} playwright test",
    "smoke": "scripts/smoke-production.sh ${BASE_URL:-https://korczis.github.io/catharsis-as-a-service/}",
    "render:artwork": "scripts/render-artwork.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/cli": "4.3.3",
    "alpinejs": "3.17.2",
    "flowbite": "4.0.2",
    "tailwindcss": "4.3.3"
  }
}
